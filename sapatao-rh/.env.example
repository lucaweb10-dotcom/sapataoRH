# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct DB connection (migrations/seed). Password must be URL-encoded.
SUPABASE_DB_URL=postgresql://postgres:URLENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Seed admin (temporary; rotate after first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# UAZAPI WhatsApp gateway
UAZAPI_API_URL=https://your-uazapi-host
UAZAPI_ADMIN_TOKEN=your-admin-token

# IA (SP3b)
LLM_PROVIDER=mock            # mock | openai (default global; empresa pode sobrescrever em Configurações > IA)
OPENAI_API_KEY=              # fallback global quando a empresa não tem chave própria

# Triagem automática (SP8)
# Segredo do worker /api/ia/tick. Sem ele a rota devolve 503 e o follow-up nao roda
# (o atendimento reativo pelo webhook continua funcionando normalmente).
IA_TICK_SECRET=
IA_TICK_URL=http://localhost:3000/api/ia/tick
